lncRNA_final_ids <- merged %>%
filter(col2extract == "lncRNA") %>%
pull(transcript_id)
View(merged)
lncRNA_final_ids <- merged %>%
filter(col2extract == "lncRNA") %>%
pull(transcript)
View(merged)
View(merged)
