cat("\n---", v, "(", res$Teste[res$Nutriente==v], ") ---\n")
ph <- posthoc_list[[v]]
keep <- intersect(c("group1","group2","estimate","conf.low","conf.high",
"statistic","p.adj","p.adj.signif"), names(ph))
print(as.data.frame(ph)[, keep], row.names = FALSE)
}
## ---- 5. Análise complementar: ANOVA fatorial 2x2 ------------------
cat("\n\n=== COMPLEMENTO: ANOVA FATORIAL 2x2 (Cultivar x Textura) ===\n")
d$Cultivar <- factor(ifelse(grepl("6007", d$Class), "IAC6007", "IAC5503"))
d$Textura  <- factor(ifelse(grepl("Argiloso", d$Class), "Argiloso", "Arenoso"))
fat <- data.frame()
for (v in nutrientes) {
m <- aov(as.formula(paste(v,"~ Cultivar*Textura")), data = d)
a <- summary(m)[[1]]
fat <- rbind(fat, data.frame(
Nutriente=v,
p_Cultivar=signif(a$`Pr(>F)`[1],3),
p_Textura=signif(a$`Pr(>F)`[2],3),
p_Interacao=signif(a$`Pr(>F)`[3],3)))
}
print(fat, row.names = FALSE)
## ---- 6. Gráficos diagnósticos -------------------------------------
png("diagnostico_qqplots.png", width=1500, height=1300, res=130)
par(mfrow=c(3,4), mar=c(4,4,2,1))
for (v in nutrientes) {
m <- aov(as.formula(paste(v,"~ Class")), data=d)
qqnorm(residuals(m), main=v, pch=19, col="#2c7fb8", cex=.8)
qqline(residuals(m), col="red", lwd=1.5)
}
invisible(dev.off())
png("boxplots_grupos.png", width=1500, height=1300, res=130)
