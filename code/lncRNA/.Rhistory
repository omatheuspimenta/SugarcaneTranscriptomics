cols <- c("#a6cee3","#1f78b4","#b2df8a","#33a02c")
for (v in nutrientes) {
boxplot(d[[v]] ~ d$Class, main=v, xlab="", ylab=v,
col=cols, las=2, cex.axis=.7)
}
invisible(dev.off())
write.csv(res, "resultados_omnibus.csv", row.names=FALSE)
