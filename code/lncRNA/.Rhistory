DP=round(ag$x[,"dp"],3),
CV=round(ag$x[,"cv"],1))
}))
View(desc)
## ---- 3. Loop principal: pressupostos + escolha + omnibus ----------
res <- data.frame()
posthoc_list <- list()
for (v in nutrientes) {
f   <- as.formula(paste(v, "~ Class"))
mod <- aov(f, data = d)
rsd <- residuals(mod)
# Normalidade dos resíduos (Shapiro-Wilk)
sw_res <- shapiro.test(rsd)
# Normalidade por grupo (referência; n=4, baixa potência)
sw_grp_min <- min(sapply(split(d[[v]], d$Class),
function(x) shapiro.test(x)$p.value))
# Homocedasticidade (Levene centrado na mediana)
lev <- car::leveneTest(f, data = d, center = median)
lev_p <- lev$`Pr(>F)`[1]
normal_ok <- sw_res$p.value > alpha
homo_ok   <- lev_p > alpha
if (normal_ok && homo_ok) {
teste <- "ANOVA"
a <- summary(mod)[[1]]
stat <- a$`F value`[1]; df1 <- a$Df[1]; df2 <- a$Df[2]; p <- a$`Pr(>F)`[1]
eta2 <- a$`Sum Sq`[1] / sum(a$`Sum Sq`)
ph <- rstatix::tukey_hsd(d, f)
} else if (normal_ok && !homo_ok) {
teste <- "Welch"
w <- oneway.test(f, data = d, var.equal = FALSE)
stat <- w$statistic; df1 <- w$parameter[1]; df2 <- w$parameter[2]; p <- w$p.value
a <- summary(mod)[[1]]; eta2 <- a$`Sum Sq`[1]/sum(a$`Sum Sq`)  # eta2 descritivo
ph <- rstatix::games_howell_test(d, f)
} else {
teste <- "Kruskal-Wallis"
k <- kruskal.test(f, data = d)
stat <- k$statistic; df1 <- k$parameter; df2 <- NA; p <- k$p.value
eta2 <- rstatix::kruskal_effsize(d, f)$effsize
ph <- rstatix::dunn_test(d, f, p.adjust.method = "BH")
}
res <- rbind(res, data.frame(
Nutriente = v,
SW_residuos_p = round(sw_res$p.value, 4),
SW_grupo_min_p = round(sw_grp_min, 4),
Levene_p = round(lev_p, 4),
Normal = ifelse(normal_ok,"sim","NAO"),
Homosced = ifelse(homo_ok,"sim","NAO"),
Teste = teste,
Estatistica = round(as.numeric(stat),3),
df1 = round(as.numeric(df1),2), df2 = round(as.numeric(df2),2),
p_bruto = signif(p,4),
eta2 = round(as.numeric(eta2),3),
row.names = NULL))
posthoc_list[[v]] <- ph
}
## ---- 4. Correção para múltiplos nutrientes (FDR-BH) ---------------
res$p_FDR <- signif(p.adjust(res$p_bruto, method = "BH"), 4)
res$Signif <- ifelse(res$p_FDR < alpha, "*", "ns")
# magnitude do efeito (Cohen): eta2 0.01 peq / 0.06 médio / 0.14 grande
res$Efeito <- cut(res$eta2, c(-Inf,0.06,0.14,Inf),
labels=c("pequeno","medio","grande"))
cat("\n=== ESTATÍSTICA DESCRITIVA (média ± DP, CV%) ===\n")
print(desc, row.names = FALSE)
cat("\n=== PRESSUPOSTOS, TESTE ESCOLHIDO E RESULTADO OMNIBUS ===\n")
print(res, row.names = FALSE)
cat("\n=== PÓS-TESTES (apenas nutrientes significativos após FDR) ===\n")
for (v in res$Nutriente[res$Signif=="*"]) {
cat("\n---", v, "(", res$Teste[res$Nutriente==v], ") ---\n")
ph <- posthoc_list[[v]]
keep <- intersect(c("group1","group2","estimate","conf.low","conf.high",
"statistic","p.adj","p.adj.signif"), names(ph))
print(as.data.frame(ph)[, keep], row.names = FALSE)
}
## ---- 5. Análise complementar: ANOVA fatorial 2x2 ------------------
cat("\n\n=== COMPLEMENTO: ANOVA FATORIAL 2x2 (Cultivar x Textura) ===\n")
d$Cultivar <- factor(ifelse(grepl("6007", d$Class), "IAC6007", "IAC5503"))
d$Textura  <- factor(ifelse(grepl("Argiloso", d$Class), "Argiloso", "Arenoso"))
fat <- data.frame()
for (v in nutrientes) {
m <- aov(as.formula(paste(v,"~ Cultivar*Textura")), data = d)
a <- summary(m)[[1]]
fat <- rbind(fat, data.frame(
Nutriente=v,
p_Cultivar=signif(a$`Pr(>F)`[1],3),
p_Textura=signif(a$`Pr(>F)`[2],3),
p_Interacao=signif(a$`Pr(>F)`[3],3)))
}
print(fat, row.names = FALSE)
## ---- 6. Gráficos diagnósticos -------------------------------------
png("diagnostico_qqplots.png", width=1500, height=1300, res=130)
par(mfrow=c(3,4), mar=c(4,4,2,1))
for (v in nutrientes) {
